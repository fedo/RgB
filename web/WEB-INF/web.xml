<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    
    <display-name>RgB TEI Document Viewer</display-name>
    
    <welcome-file-list>
        <welcome-file>welcomeGWT.html</welcome-file>
    </welcome-file-list>
    
    <!-- Servlets -->
    <servlet>
        <servlet-name>DocumentViewer</servlet-name>
        <servlet-class>it.unibo.cs.rgb.servlet.DocumentViewer</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DocumentsList</servlet-name>
        <servlet-class>it.unibo.cs.rgb.servlet.DocumentsList</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DocumentInfo</servlet-name>
        <servlet-class>it.unibo.cs.rgb.servlet.DocumentInfo</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Dispatcher</servlet-name>
        <servlet-class>it.unibo.cs.rgb.servlet.Dispatcher</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>StemmaCodicum</servlet-name>
        <servlet-class>it.unibo.cs.rgb.servlet.StemmaCodicum</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>EstrazioneDiConcordanze</servlet-name>
        <servlet-class>it.unibo.cs.rgb.servlet.EstrazioneDiConcordanze</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Differenziazione</servlet-name>
        <servlet-class>it.unibo.cs.rgb.servlet.Differenziazione</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DocumentNoteViewer</servlet-name>
        <servlet-class>it.unibo.cs.rgb.servlet.DocumentNoteViewer</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Test</servlet-name>
        <servlet-class>it.unibo.cs.rgb.servlet.Test</servlet-class>
    </servlet>
    
    <!-- Servlet Mappings -->
    <servlet-mapping>
        <servlet-name>DocumentViewer</servlet-name>
        <url-pattern>/DocumentViewer</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DocumentsList</servlet-name>
        <url-pattern>/DocumentsList</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DocumentInfo</servlet-name>
        <url-pattern>/DocumentInfo</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Dispatcher</servlet-name>
        <url-pattern>/Dispatcher</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StemmaCodicum</servlet-name>
        <url-pattern>/StemmaCodicum</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>EstrazioneDiConcordanze</servlet-name>
        <url-pattern>/EstrazioneDiConcordanze</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Differenziazione</servlet-name>
        <url-pattern>/Differenziazione</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DocumentNoteViewer</servlet-name>
        <url-pattern>/DocumentNoteViewer</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Test</servlet-name>
        <url-pattern>/Test</url-pattern>
    </servlet-mapping>
    
    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
</web-app>
