<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Google Inc.//DTD Google Web Toolkit 2.11.0//EN"
        "https://www.gwtproject.org/doctype/2.11.0/gwt-module.dtd">

<module rename-to="Main">
    <!-- Inherit the core Web Toolkit stuff -->
    <inherits name="com.google.gwt.user.User"/>
    
    <!-- Inherit the XML module for XML parsing -->
    <inherits name="com.google.gwt.xml.XML"/>
    
    <!-- Inherit HTTP module for RequestBuilder -->
    <inherits name="com.google.gwt.http.HTTP"/>

    <!-- GWT Theme - using the clean theme for modern look -->
    <inherits name="com.google.gwt.user.theme.clean.Clean"/>

    <!-- Specify the entry point class -->
    <entry-point class="it.unibo.cs.rgb.gwt.client.MainEntryPoint"/>

    <!-- Specify the source path (client-side code) -->
    <source path="client"/>
    
    <!-- Collapse all permutations for faster development builds -->
    <!-- Remove or comment out for production -->
    <collapse-all-properties/>
    
    <!-- Set default locale -->
    <extend-property name="locale" values="it"/>
    <set-property-fallback name="locale" value="it"/>

    <!-- Do not define servlets here, use web.xml -->
</module>
